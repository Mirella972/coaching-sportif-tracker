# ============================
# 🔐 Airtable Configuration
# ============================

# Ton jeton d'accès personnel Airtable (PAT)
# Génére-le ici : https://airtable.com/create/tokens
REACT_APP_AIRTABLE_ACCESS_TOKEN=your_airtable_access_token_here

# ID de ta base Airtable (ex: app8673yjmXB3WcDT)
# Tu peux le trouver dans l'URL de ta base ou via l'API metadata
REACT_APP_AIRTABLE_BASE_ID=your_base_id_here

# ID de la table principale (ex: tbl5MlIcTSqCOLEJ)
# Tu peux le trouver dans l'URL ou avec Airtable Inspector
REACT_APP_AIRTABLE_TABLE_ID=your_table_id_here